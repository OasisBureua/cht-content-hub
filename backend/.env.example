PUBLIC_API_KEY=dev-change-me
DATABASE_URL=postgresql+asyncpg://contenthub:contenthub@localhost:5433/contenthub_producer

# CPR-13 / CPR-28 platform export (Hub is M2M client)
# PLATFORM_EXPORT_BASE_URL=https://devapp.communityhealth.media
# PLATFORM_EXPORT_HTTP_MODE=input_packet
# Prefer loading M2M from Secrets Manager (Uche: cht-dev-cognito-m2m-export):
# PLATFORM_EXPORT_M2M_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:cht-dev-cognito-m2m-export
# Or set explicitly for local (never commit secrets):
# PLATFORM_EXPORT_TOKEN_URL=
# PLATFORM_EXPORT_CLIENT_ID=
# PLATFORM_EXPORT_CLIENT_SECRET=
# PLATFORM_EXPORT_SCOPE=platform/export.read
# PLATFORM_EXPORT_TRANSCRIPT_BUCKET=
# PLATFORM_EXPORT_FIXTURE_DIR=

# Inbound M2M — Hub resource server identifier is `hub` (hub/catalog.read).
# Local/tests: HUB_M2M_TEST_SECRET (HS256). AWS: issuer + JWKS (RS256).
# HUB_M2M_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<userPoolId>
# HUB_M2M_RESOURCE=hub
# HUB_M2M_AUDIENCE=
# HUB_M2M_JWKS_URL=
# HUB_M2M_TEST_SECRET=
